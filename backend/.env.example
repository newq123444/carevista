# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/carevista?sslmode=require
# SSL auto-enables when the URL contains sslmode=require, in production, or when PGSSL=true.
# For a local Postgres without SSL, omit sslmode and leave PGSSL unset.
# PGSSL=true

# ── Redis (optional; sessions/caching) ──────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379

# ── Auth ── JWT secrets MUST be >= 32 random chars in production ─────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Comma-separated allowlist of frontend origins. REQUIRED in production.
CORS_ORIGIN=https://your-frontend.vercel.app

# ── AI (Anthropic) ── leave blank to run with AI features gracefully disabled
ANTHROPIC_API_KEY=
# Model id is configurable so it can be updated without a code change
ANTHROPIC_MODEL=claude-sonnet-5

# ── File storage (optional S3) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-2

# ── Email (optional SMTP) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@carevista.app
